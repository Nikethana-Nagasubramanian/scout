# Copy this file to .env and fill in only what you need. Scout runs with none of these set.

# Claude API, for resume prioritization and cover letters. Without it, Scout uses Ollama if
# it is running, then a deterministic draft. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Local Ollama. Only needed if Ollama is not on its default address.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_KEEP_ALIVE=30m

# Exa, for finding companies hiring before they appear on job boards. https://exa.ai
EXA_API_KEY=

# Hunter, for contact research on the Contacts page. https://hunter.io
HUNTER_API_KEY=

# Gmail job alerts, for hiring signals on Target companies. Use a Google app password,
# not your account password. https://myaccount.google.com/apppasswords
SCOUT_GMAIL_ADDRESS=
SCOUT_GMAIL_APP_PASSWORD=
SCOUT_GMAIL_LABEL=
