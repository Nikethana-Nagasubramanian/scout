{
  "name": "job-search-copilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.3",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "collect": "tsx scripts/collect.ts",
    "collect:gmail": "tsx scripts/collect.ts gmail_manual",
    "scheduler:tick": "tsx scripts/scheduler-tick.ts",
    "scheduler:install": "tsx scripts/install-scheduler.ts",
    "scheduler:remove": "tsx scripts/remove-scheduler.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "verify": "pnpm run check:no-em-dash && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/young-serif": "^5.3.0",
    "better-sqlite3": "^11.8.1",
    "docx": "^9.2.0",
    "imapflow": "^1.5.0",
    "mailparser": "^3.9.14",
    "next": "^16.0.0",
    "pdfkit": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.8",
    "tsx": "^4.19.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.13.4",
    "@types/pdfkit": "^0.13.8",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.20.1",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "sharp": "^0.35.0"
    }
  }
}
